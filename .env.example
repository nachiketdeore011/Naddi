# ============================================================
# Environment Variables for Production
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Domain & TLS ──
# Your domain name (no protocol, no trailing slash)
DOMAIN=nadi.example.com

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=you@example.com

# ── Traefik Dashboard Auth ──
# Generate with: htpasswd -nb admin yourpassword
# Note: $$ is escaped $ for docker-compose
DASHBOARD_AUTH=admin:$$apr1$$xyz$$placeholder

# ── Database ──
POSTGRES_USER=nadi
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=nadi_db

# ── Backend ──
DATABASE_URL=postgresql://nadi:change-me-to-a-strong-password@db:5432/nadi_db
ML_SERVICE_URL=http://ml:8001
